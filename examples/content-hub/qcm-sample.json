{
  "schemaVersion": 1,
  "id": "sample-spark-qcm",
  "title": "Spark execution quick assessment",
  "taxonomy": {
    "subject": "it",
    "path": [
      "Data Engineering",
      "Apache Spark"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "prompt": "Which operation triggers Spark execution?",
      "options": [
        {
          "id": "a",
          "text": "select()",
          "explanation": "A transformation; it remains lazy."
        },
        {
          "id": "b",
          "text": "filter()",
          "explanation": "A transformation; it remains lazy."
        },
        {
          "id": "c",
          "text": "count()",
          "explanation": "An action that requests a result and triggers execution."
        },
        {
          "id": "d",
          "text": "withColumn()",
          "explanation": "A transformation; it remains lazy."
        }
      ],
      "correctOptionIds": [
        "c"
      ],
      "explanation": "Spark transformations build a logical plan; actions such as count() trigger execution."
    },
    {
      "id": "q2",
      "prompt": "Which can cause a wide dependency / shuffle? Select all that apply.",
      "options": [
        {
          "id": "a",
          "text": "groupBy()",
          "explanation": "Usually redistributes rows by grouping key."
        },
        {
          "id": "b",
          "text": "join()",
          "explanation": "Can require redistribution unless the plan avoids it, e.g. broadcast."
        },
        {
          "id": "c",
          "text": "select()",
          "explanation": "Normally a narrow projection."
        },
        {
          "id": "d",
          "text": "orderBy()",
          "explanation": "Global ordering generally requires a shuffle."
        }
      ],
      "correctOptionIds": [
        "a",
        "b",
        "d"
      ],
      "explanation": "Wide operations can require data movement across partitions."
    }
  ]
}
