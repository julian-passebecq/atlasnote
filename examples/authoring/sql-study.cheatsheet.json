    {
      "id": "authoring-sql-p2",
      "title": "CTEs and deterministic windows",
      "blocks": [
        {
          "id": "authoring-sql-p2-title",
          "type": "text",
          "role": "title",
          "text": "CTEs and deterministic windows",
          "style": {
            "fontSize": 38,
            "minFontSize": 32,
            "overflow": "error"
          }
        },
        {
          "id": "authoring-sql-p2-b1",
          "type": "text",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "text": "One latest row per customer\nUse a stable tie-breaker so equal dates yield a deterministic latest order."
        },
        {
          "id": "authoring-sql-p2-b2",
          "type": "code",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "language": "sql",
          "title": "Rank and filter in separate steps",
          "code": "WITH ranked AS (\n  SELECT id, customer_id, ordered_at,\n    ROW_NUMBER() OVER (\n      PARTITION BY customer_id\n      ORDER BY ordered_at DESC, id DESC\n    ) AS rn\n  FROM orders\n)\nSELECT id, customer_id FROM ranked WHERE rn = 1;"
        },
        {
          "id": "authoring-sql-p2-b3",
          "type": "code",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "language": "sql",
          "title": "Running total over observed rows",
          "code": "SELECT id, customer_id, amount,\n  SUM(amount) OVER (\n    PARTITION BY customer_id\n    ORDER BY ordered_at, id\n    ROWS BETWEEN UNBOUNDED PRECEDING\n             AND CURRENT ROW\n  ) AS running_amount\nFROM orders;"
        },
        {
          "id": "authoring-sql-p2-b4",
          "type": "text",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "text": "Exercise and dialect\nRemove the ID tie-breaker and explain the ambiguity. Independently authored SQLite 3 / portable PostgreSQL examples; no screenshot SQL transcription."
        }
      ],
