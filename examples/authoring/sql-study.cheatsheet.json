            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "text": "Filtering and grouping\nApply WHERE before grouping; HAVING tests groups after aggregation."
        },
        {
          "id": "authoring-sql-p1-b2",
          "type": "code",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "language": "sql",
          "title": "At least two orders per customer",
          "code": "SELECT customer_id, COUNT(*) AS orders\nFROM orders\nWHERE amount > 0\nGROUP BY customer_id\nHAVING COUNT(*) >= 2\nORDER BY orders DESC, customer_id;"
        },
        {
          "id": "authoring-sql-p1-b3",
          "type": "table",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "columns": [
            "customer_id",
            "orders"
          ],
          "rows": [
            [
              "Ada",
              "2"
            ]
          ]
        },
        {
          "id": "authoring-sql-p1-b4",
          "type": "code",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "language": "sql",
          "title": "Keep customers without orders",
          "code": "SELECT c.id, COUNT(o.id) AS orders\nFROM customers AS c\nLEFT JOIN orders AS o ON o.customer_id = c.id\nGROUP BY c.id\nORDER BY c.id;"
        },
        {
          "id": "authoring-sql-p1-b5",
          "type": "text",
          "style": {
            "fontSize": 22,
            "minFontSize": 20,
            "lineHeight": 1.3,
            "overflow": "error"
          },
          "text": "Exercise\nWhy does COUNT(*) count one row for a customer with no matched order? Try COUNT(o.id)."
        }
      ],
