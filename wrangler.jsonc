{
  "name": "atlasnote-local",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node tools/cloudflare-release-guard.mjs --target local"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
