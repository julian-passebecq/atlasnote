{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist/app",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/vendor/mermaid",
    "src/online.tsx",
    "src/vendor/prism.js",
    "src/vendor/jszip.js",
    "src/online"
  ]
}
