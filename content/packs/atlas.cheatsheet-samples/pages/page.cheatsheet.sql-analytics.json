            },
            "id": "sql-analytics.p1.b9"
          },
          {
            "type": "code",
            "language": "sql",
            "code": "SELECT dept, COUNT(*) AS n\nFROM emp\nWHERE hired >= '2024-01-01'  -- rows\nGROUP BY dept\nHAVING COUNT(*) > 5;        -- groups",
            "title": "Example - grouped query",
            "style": {
              "fontSize": 16,
              "lineHeight": 1.35,
              "overflow": "shrink",
              "minFontSize": 14
            },
            "id": "sql-analytics.p1.b10"
          },
          {
            "type": "box",
            "variant": "warning",
            "title": "Common trap",
            "text": "HAVING with no GROUP BY treats the whole result as one group.\nA row filter in HAVING still works, but scans far more rows.",
            "style": {
              "fontSize": 18,
              "lineHeight": 1.25,
              "overflow": "shrink",
              "minFontSize": 16
            },
            "id": "sql-analytics.p1.b11"
          },
          {
            "type": "code",
            "language": "sql",
            "code": "-- grain = (dept): 1 row per dept\n-- grain = (dept, month): 1 per dept-month\nSELECT dept, DATE_TRUNC('month', d) AS m,\n       SUM(amt) AS total,\n       COUNT(DISTINCT emp_id) AS people\nFROM sales GROUP BY 1, 2;",
            "title": "Example - changing the grain",
            "style": {
              "fontSize": 16,
              "lineHeight": 1.35,
              "overflow": "shrink",
              "minFontSize": 14
            },
            "id": "sql-analytics.p1.b12"
          },
          {
            "type": "box",
            "variant": "warning",
            "title": "Common trap",
            "text": "JOIN before GROUP BY fans out rows and inflates SUM.\nSymptom: totals that are an exact multiple of the truth.",
            "style": {
              "fontSize": 18,
              "lineHeight": 1.25,
              "overflow": "shrink",
              "minFontSize": 16
            },
            "id": "sql-analytics.p1.b13"
          },
          {
            "type": "table",
