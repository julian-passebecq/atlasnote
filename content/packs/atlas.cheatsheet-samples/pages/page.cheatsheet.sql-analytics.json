              "minFontSize": 16
            },
            "id": "sql-analytics.p1.b14"
          },
          {
            "type": "box",
            "variant": "warning",
            "title": "Common trap",
            "text": "LEFT JOIN ... WHERE b.col = 'x' silently becomes an INNER JOIN.\nFilter the right table in ON; filter the left table in WHERE.",
            "style": {
              "fontSize": 18,
              "lineHeight": 1.25,
              "overflow": "shrink",
