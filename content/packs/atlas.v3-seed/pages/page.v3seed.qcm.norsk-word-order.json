        "id": "question.v3seed.no.q1",
        "prompt": "Choose the correct main clause that starts with \"I morgen\".",
        "options": [
          {
            "id": "option.v3seed.no.q1.a",
            "text": "I morgen jeg skal jobbe hjemme."
          },
          {
            "id": "option.v3seed.no.q1.b",
            "text": "I morgen skal jeg jobbe hjemme."
          },
          {
            "id": "option.v3seed.no.q1.c",
            "text": "I morgen jobbe jeg skal hjemme."
          },
          {
            "id": "option.v3seed.no.q1.d",
            "text": "I morgen jeg jobber hjemme skal."
          }
        ],
        "correctOptionIds": [
          "option.v3seed.no.q1.b"
        ],
        "explanation": "I morgen fills position 1, so the finite verb skal takes position 2 and the subject jeg follows it (V2).",
