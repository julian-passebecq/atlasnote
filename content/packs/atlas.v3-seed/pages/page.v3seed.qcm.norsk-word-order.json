      {
        "id": "question.v3seed.no.q4",
        "prompt": "Which words normally introduce a subordinate clause? Select all that apply.",
        "options": [
          {
            "id": "option.v3seed.no.q4.a",
            "text": "fordi"
          },
          {
            "id": "option.v3seed.no.q4.b",
            "text": "hvis"
          },
          {
            "id": "option.v3seed.no.q4.c",
            "text": "selv om"
          },
          {
            "id": "option.v3seed.no.q4.d",
            "text": "men",
            "explanation": "men is a coordinating conjunction: main-clause order follows."
          },
          {
            "id": "option.v3seed.no.q4.e",
            "text": "og"
          },
          {
            "id": "option.v3seed.no.q4.f",
            "text": "derfor",
            "explanation": "derfor is an adverb; in position 1 it triggers V2 inversion: Derfor kommer jeg."
          }
        ],
        "correctOptionIds": [
          "option.v3seed.no.q4.a",
          "option.v3seed.no.q4.b",
          "option.v3seed.no.q4.c"
        ],
        "explanation": "fordi, hvis and selv om are subjunctions. og and men join main clauses; derfor is an adverb.",
        "links": [
