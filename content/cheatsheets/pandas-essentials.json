    {
      "id": "pandas-essentials.p2",
      "title": "pandas - Missing Data, Reshape & Speed",
      "blocks": [
        {
          "type": "text",
          "role": "title",
          "text": "pandas - Missing Data, Reshape & Speed",
          "style": {
            "fontSize": 38,
            "minFontSize": 29,
            "overflow": "shrink",
            "lineHeight": 1.16
          },
          "id": "pandas-essentials.p2.title"
        },
        {
          "type": "text",
          "role": "section",
          "text": "5. Missing Values",
          "style": {
            "fontSize": 27,
            "minFontSize": 23,
            "overflow": "shrink",
            "lineHeight": 1.2
          },
          "id": "pandas-essentials.p2.s1"
        },
        {
          "type": "text",
          "text": "Four different nulls, and none of them equals itself.",
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32
          },
          "id": "pandas-essentials.p2.b1"
        },
        {
          "type": "list",
          "items": [
            "Always test with .isna(), never with == np.nan.",
            "Nullable dtypes ('Int64', 'boolean') keep integers integral.",
            "dropna(subset=[...]) beats a bare dropna() every time."
          ],
          "gap": 24,
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32,
            "overflow": "shrink",
            "minFontSize": 20
          },
          "id": "pandas-essentials.p2.b2"
        },
        {
          "type": "text",
          "role": "section",
          "text": "6. pivot_table vs pivot",
          "style": {
            "fontSize": 27,
            "minFontSize": 23,
            "overflow": "shrink",
            "lineHeight": 1.2
          },
          "id": "pandas-essentials.p2.s2"
        },
        {
          "type": "text",
          "text": "Same shape of output, different tolerance for duplicates.",
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32
          },
          "id": "pandas-essentials.p2.b3"
        },
        {
          "type": "list",
          "items": [
            [
              {
                "text": "pivot",
                "marks": [
                  "key"
                ]
              },
              {
                "text": " - pure reshape; raises on duplicate index/column pairs."
              }
            ],
            [
              {
                "text": "pivot_table",
                "marks": [
                  "key"
                ]
              },
              {
                "text": " - aggregates duplicates, default aggfunc='mean'."
              }
            ],
            [
              {
                "text": "melt",
                "marks": [
                  "key"
                ]
              },
              {
                "text": " - the inverse: wide back to long."
              }
            ]
          ],
          "gap": 24,
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32,
            "overflow": "shrink",
            "minFontSize": 20
          },
          "id": "pandas-essentials.p2.b4"
        },
        {
          "type": "text",
          "role": "section",
          "text": "7. apply vs Vectorized",
          "style": {
            "fontSize": 27,
            "minFontSize": 23,
            "overflow": "shrink",
            "lineHeight": 1.2
          },
          "id": "pandas-essentials.p2.s3"
        },
        {
          "type": "text",
          "text": "apply(axis=1) builds a Series per row. It is a Python loop wearing a pandas coat.",
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32
          },
          "id": "pandas-essentials.p2.b5"
        },
        {
          "type": "list",
          "items": [
            "Two branches -> np.where. Many branches -> np.select.",
            "Lookup by key -> .map(dict) or a merge, not apply.",
            "String work -> .str accessor, which is already vectorized."
          ],
          "gap": 24,
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32,
            "overflow": "shrink",
            "minFontSize": 20
          },
          "id": "pandas-essentials.p2.b6"
        },
        {
          "type": "text",
          "role": "section",
          "text": "8. Performance Checklist",
          "style": {
            "fontSize": 27,
            "minFontSize": 23,
            "overflow": "shrink",
            "lineHeight": 1.2
          },
          "id": "pandas-essentials.p2.s4"
        },
        {
          "type": "list",
          "items": [
            "category dtype for low-cardinality strings - often 10x smaller.",
            "Never grow a frame in a loop; collect rows, concat once.",
            ".to_numpy() before heavy arithmetic to drop index alignment.",
            "Copy-on-write (pandas 3.x) makes chained assignment an error, not a warning."
          ],
          "gap": 20.18666666666664,
          "style": {
            "fontSize": 21,
            "lineHeight": 1.32,
            "overflow": "shrink",
            "minFontSize": 20
          },
          "id": "pandas-essentials.p2.b7"
        },
        {
          "type": "table",
          "columns": [
            "Value",
            "Dtype",
            "Note"
          ],
          "rows": [
            [
              "np.nan",
              "float64",
              "upcasts ints"
            ],
            [
              "pd.NA",
              "Int64, boolean",
              "propagates"
            ],
            [
              "NaT",
              "datetime64",
              "time nulls"
            ],
            [
              "None",
              "object",
              "avoid"
            ]
          ],
          "widths": [
            0.25,
            0.43,
            0.32
          ],
          "style": {
            "fontSize": 17,
            "lineHeight": 1.25,
            "overflow": "shrink",
            "minFontSize": 16
          },
          "id": "pandas-essentials.p2.b8"
        },
        {
          "type": "code",
          "language": "python",
          "code": "df.isna().sum()\ndf[\"a\"] = df[\"a\"].astype(\"Int64\")  # nullable int\ndf[\"a\"] = df[\"a\"].fillna(0)\ndf = df.dropna(subset=[\"key\"])\ndf[\"v\"] = df[\"v\"].ffill()  # not fillna(method=)",
          "title": "Example - missing-data idioms",
          "style": {
            "fontSize": 16,
            "lineHeight": 1.35,
            "overflow": "shrink",
            "minFontSize": 14
          },
          "id": "pandas-essentials.p2.b9"
        },
        {
          "type": "code",
          "language": "python",
          "code": "df.pivot_table(index=\"region\", columns=\"month\",\n    values=\"sales\", aggfunc=\"sum\",\n    fill_value=0, margins=True)\n\nwide.melt(id_vars=\"region\", var_name=\"month\",\n    value_name=\"sales\")",
          "title": "Example - reshape",
          "style": {
            "fontSize": 16,
            "lineHeight": 1.35,
            "overflow": "shrink",
            "minFontSize": 14
          },
          "id": "pandas-essentials.p2.b10"
        },
        {
          "type": "table",
          "columns": [
            "Approach",
            "Relative cost"
          ],
          "rows": [
            [
              "Vectorized column math",
              "1x"
            ],
            [
              "np.where / np.select",
              "~1x"
            ],
            [
              ".map(dict)",
              "~2x"
            ],
            [
              ".apply(axis=1)",
              "10-100x"
            ]
          ],
          "widths": [
            0.69,
            0.31
          ],
          "style": {
            "fontSize": 17,
            "lineHeight": 1.25,
            "overflow": "shrink",
            "minFontSize": 16
          },
          "id": "pandas-essentials.p2.b11"
        },
        {
          "type": "code",
          "language": "python",
          "code": "# slow\ndf[\"band\"] = df.apply(lambda r: \"big\"\n    if r.amt > 100 else \"small\", axis=1)\n# fast\ndf[\"band\"] = np.where(df.amt > 100, \"big\", \"small\")\ndf[\"band\"] = np.select([df.amt > 500, df.amt > 100],\n    [\"huge\", \"big\"], default=\"small\")",
          "title": "Example - slow vs fast",
          "style": {
            "fontSize": 16,
            "lineHeight": 1.35,
            "overflow": "shrink",
            "minFontSize": 14
          },
          "id": "pandas-essentials.p2.b12"
        }
      ],
      "frames": {
        "pandas-essentials.p2.title": {
