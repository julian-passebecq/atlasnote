{
  "name": "knowledge-atlas",
  "version": "1.2.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node tools/build-vite.mjs",
    "dev": "npm run build && node tools/serve.mjs",
    "local": "npm run dev",
    "preview": "node tools/serve.mjs",
    "validate": "node tools/compile-content.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tests/browser_test.py",
    "pack:local": "node tools/package-library.mjs",
    "check:release": "node tools/check-release.mjs",
    "enable:online": "node tools/enable-online.mjs",
    "build:vite": "node tools/build-vite.mjs",
    "test:dom": "python tests/dom_test.py",
    "pretest": "npm run build:offline",
    "test:hardening:ui": "python tests/hardening_dom.py",
    "test:runtime": "python tests/release_runtime.py",
    "test:pdf": "python tests/pdf_runtime.py",
    "test:online:syntax": "node tools/check-online-syntax.mjs",
    "audit:local": "node tools/audit-local.mjs",
    "test:headers": "python tests/headers_test.py",
    "typecheck:online": "tsc --project tsconfig.online.json --noEmit",
    "bootstrap:offline": "node tools/bootstrap-offline.mjs",
    "test:reader:ui": "python tests/reader_11_dom.py",
    "test:pdf:authoring": "python tests/pdf_authoring_test.py",
    "pdf:library:validate": "python templates/pdf-library/tools/validate_library.py templates/pdf-library",
    "pdf:library:build": "python templates/pdf-library/tools/build_atlas_library.py --root templates/pdf-library",
    "pdfatlas:sync": "node tools/sync-pdfatlas.mjs",
    "test:compact:ui": "python tests/compact_12_dom.py",
    "test:startup:dom": "python tests/startup_diagnostic.py",
    "build:offline": "node tools/build.mjs",
    "dev:offline": "node tools/build.mjs && node tools/serve-offline.mjs",
    "check:release:offline": "node tools/check-release.mjs dist-offline",
    "test:finish:ui": "python tests/finish_121_dom.py",
    "test:backup:diagnostic": "python tests/backup_diagnostic.py",
    "test:finish:integrated": "python tests/finish_121_integrated.py",
    "check:integrated-deps": "node tools/check-integrated-deps.mjs",
    "test:workspaces:ui": "python tests/workspace_122_dom.py",
    "test:workspaces:runtime": "python tests/workspace_122_runtime.py",
    "test:simplified:ui": "python tests/simplified_123_dom.py",
    "build:test-harness": "node tools/build-test-harness.mjs",
    "test:pdf:component": "python tests/engine_123_dom.py",
    "test:savedstates:runtime": "python tests/saved_states_runtime.py",
    "test:release": "node tools/run-release.mjs",
    "test:reading:ui": "python tests/reading_124_dom.py",
    "test:pdf:grid": "python tests/grid_124_dom.py",
    "test:reading:runtime": "python tests/reading_124_runtime.py",
    "test:polish:ui": "python tests/reader_polish_125_dom.py",
    "test:pdf:wheel": "python tests/wheel_125_dom.py",
    "test:interviews": "node tools/generate-interviews.mjs --check"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "10.5.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.8.3",
    "vite": "8.2.2"
  }
}
