                      "code": "@concat('raw/', formatDateTime(utcnow(), 'yyyy/MM/dd'))\n@activity('Lookup1').output.firstRow.watermark\n@greater(int(variables('cnt')), 0)",
                      "title": "Example - expressions",
                      "style": {
                        "fontSize": 16,
