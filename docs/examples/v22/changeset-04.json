                    {
                      "type": "text",
                      "role": "section",
                      "text": "1. Object Model",
                      "style": {
                        "fontSize": 27,
                        "minFontSize": 23,
                        "overflow": "shrink",
                        "lineHeight": 1.2
                      },
                      "id": "azure-data-factory.p1.s1"
                    },
                    {
                      "type": "text",
                      "text": "Six objects in the supplied reference: name each one before wiring the pipeline.",
                      "style": {
                        "fontSize": 21,
                        "lineHeight": 1.32
                      },
                      "id": "azure-data-factory.p1.b1"
                    },
                    {
                      "type": "list",
                      "items": [
                        [
                          {
                            "text": "Linked service",
                            "marks": [
                              "key"
                            ]
                          },
                          {
                            "text": " - connection to a system."
                          }
                        ],
                        [
                          {
                            "text": "Dataset",
                            "marks": [
                              "key"
                            ]
                          },
                          {
                            "text": " - the data an activity reads or writes."
                          }
                        ],
                        [
                          {
                            "text": "Activity",
                            "marks": [
                              "key"
                            ]
                          },
                          {
                            "text": " - a unit of work."
                          }
                        ],
                        [
                          {
                            "text": "Pipeline",
                            "marks": [
                              "key"
                            ]
                          },
                          {
                            "text": " - a group of activities."
                          }
                        ],
                        [
                          {
                            "text": "Trigger",
                            "marks": [
                              "key"
                            ]
                          },
                          {
                            "text": " - starts the pipeline."
                          }
                        ],
                        [
                          {
                            "text": "Integration runtime",
                            "marks": [
                              "key"
                            ]
                          },
                          {
                            "text": " - the execution/connectivity runtime."
                          }
                        ]
                      ],
                      "gap": 24,
                      "style": {
                        "fontSize": 21,
                        "lineHeight": 1.32,
                        "overflow": "shrink",
                        "minFontSize": 20
                      },
                      "id": "azure-data-factory.p1.b2"
                    },
                    {
                      "type": "text",
                      "role": "section",
                      "text": "2. Linked Service & Dataset",
                      "style": {
                        "fontSize": 27,
                        "minFontSize": 23,
                        "overflow": "shrink",
                        "lineHeight": 1.2
                      },
                      "id": "azure-data-factory.p1.s2"
                    },
                    {
                      "type": "list",
                      "items": [
                        "Use one linked service per system.",
                        "Keep secrets in Key Vault.",
                        "Parameterize the dataset rather than duplicating it."
                      ],
                      "gap": 24,
                      "style": {
                        "fontSize": 21,
                        "lineHeight": 1.32,
                        "overflow": "shrink",
                        "minFontSize": 20
                      },
                      "id": "azure-data-factory.p1.b3"
                    },
                    {
                      "type": "text",
                      "role": "section",
                      "text": "3. Pipeline & Activities",
                      "style": {
                        "fontSize": 27,
                        "minFontSize": 23,
                        "overflow": "shrink",
                        "lineHeight": 1.2
                      },
                      "id": "azure-data-factory.p1.s3"
                    },
                    {
                      "type": "list",
                      "items": [
                        "Read dependency conditions explicitly.",
                        "Multiple dependency conditions are AND, not OR.",
                        "Check ForEach limits before fan-out."
                      ],
                      "gap": 24,
                      "style": {
                        "fontSize": 21,
                        "lineHeight": 1.32,
                        "overflow": "shrink",
                        "minFontSize": 20
                      },
                      "id": "azure-data-factory.p1.b4"
                    },
                    {
                      "type": "text",
                      "role": "section",
                      "text": "4. Triggers",
                      "style": {
                        "fontSize": 27,
                        "minFontSize": 23,
                        "overflow": "shrink",
                        "lineHeight": 1.2
                      },
                      "id": "azure-data-factory.p1.s4"
                    },
                    {
                      "type": "text",
                      "text": "The reference distinguishes firing conditions from backfill behavior.",
