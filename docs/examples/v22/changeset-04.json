                      },
                      "id": "azure-data-factory.p2.b10"
                    },
                    {
                      "type": "box",
                      "variant": "warning",
                      "title": "Common trap",
                      "text": "A leading @ makes the whole string an expression; inside a literal use @{...}.\nEscape a real @ by doubling it: @@.\n@{} inside an @-expression is a string-interpolation error.",
                      "style": {
                        "fontSize": 18,
                        "lineHeight": 1.25,
                        "overflow": "shrink",
                        "minFontSize": 16
                      },
                      "id": "azure-data-factory.p2.b11"
                    },
                    {
                      "type": "box",
                      "variant": "note",
                      "title": "Important",
                      "text": "Rerun from failed activity preserves the original run id - the rerun shows under the same pipeline run.\nDiagnostic settings must be enabled before the run, not after.",
                      "style": {
                        "fontSize": 18,
                        "lineHeight": 1.25,
                        "overflow": "shrink",
                        "minFontSize": 16
                      },
                      "id": "azure-data-factory.p2.b12"
