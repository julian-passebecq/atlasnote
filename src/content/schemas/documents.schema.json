{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas document sidecar",
  "type": "object",
  "properties": {
    "format": {
      "const": "atlas-document-index"
    },
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "documents": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          },
          "pageId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "pack-file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "library-file"
                  },
                  "libraryId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "libraryId",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "https"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "external-link"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "visibility": {
            "enum": [
              "public",
              "private",
              "unreviewed"
            ]
          },
          "rights": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "author-created",
                  "permission",
                  "reference-only",
                  "unreviewed"
                ]
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "status",
              "attribution"
            ],
            "additionalProperties": false
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "defaultView": {
            "enum": [
              "single",
              "continuous",
              "spread"
            ]
          }
        },
        "required": [
          "id",
          "pageId",
          "title",
          "source",
          "visibility",
          "rights"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "properties": {
                    "kind": {
                      "const": "external-link"
                    }
                  }
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sha256"
                    ]
                  },
                  {
                    "required": [
                      "bytes"
                    ]
                  },
                  {
                    "required": [
                      "pageCount"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "sha256",
                "bytes"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "packId",
    "version",
    "documents"
  ],
  "additionalProperties": false
}
